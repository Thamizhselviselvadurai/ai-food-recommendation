# ---------------------------------------------------------------------------
# Client configuration — copy to `client/.env` (optional; defaults work).
# Only VITE_* variables are exposed to the browser. NEVER put a secret here:
# anything in this file ships inside the JavaScript bundle.
# ---------------------------------------------------------------------------

# Where the dev server proxies /api to. Change if the API runs on another port.
VITE_API_PROXY_TARGET=http://localhost:5000

# Absolute API base URL. Leave empty in development so the Vite proxy is used.
# Set it for production builds served from a different origin than the API.
VITE_API_BASE_URL=

# Map tiles. Defaults to the public OpenStreetMap tile server, which needs no
# key but is rate-limited and not for heavy production traffic — swap in your
# own tile provider URL for a real deployment.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
