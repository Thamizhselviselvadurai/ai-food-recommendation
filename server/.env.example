# ---------------------------------------------------------------------------
# Server configuration — copy to `server/.env` and fill in.
# NEVER commit the real .env file. No secret in this repo is hard-coded.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Option A (recommended for a real setup): local MongoDB or MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/food_ai

# Option B (zero-install demo): run an ephemeral in-memory MongoDB.
# Data is wiped on restart and re-seeded automatically. Requires the
# `mongodb-memory-server` dev dependency (installed by `npm install`).
USE_MEMORY_DB=false

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# AI (optional) — Anthropic Claude
# ---------------------------------------------------------------------------
# Without a key the app still works end to end: a deterministic rule-based NLU
# parses the user's sentence and template explanations are generated instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Set to false to force the rule-based fallback even when a key is present.
AI_ENABLED=true

# ---------------------------------------------------------------------------
# Weather (optional contextual signal)
# ---------------------------------------------------------------------------
# `open-meteo` needs no API key. `openweather` needs OPENWEATHER_API_KEY.
# `off` disables the weather signal entirely.
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Crowd prediction
# ---------------------------------------------------------------------------
# Optional: URL of the Python ML crowd service (see /ml). When unset, the
# deterministic rule-based crowd engine is used instead.
ML_CROWD_SERVICE_URL=
ML_CROWD_TIMEOUT_MS=1200

# ---------------------------------------------------------------------------
# Defaults used when the browser denies location permission
# ---------------------------------------------------------------------------
DEFAULT_LAT=11.0168
DEFAULT_LNG=76.9558
DEFAULT_CITY=Coimbatore

# ---------------------------------------------------------------------------
# Live restaurant data ("real restaurants near me")
# ---------------------------------------------------------------------------
# auto   - use Google when GOOGLE_MAPS_API_KEY is set, otherwise OpenStreetMap
# osm    - always OpenStreetMap (keyless, worldwide, no ratings/prices/photos)
# google - always Google Places (needs a key)
PLACES_PROVIDER=auto

# Total budget for ONE live lookup across every provider tried. OSM is queried
# through Overpass and Nominatim in parallel and the first to answer wins, so
# this is a ceiling for a bad day, not the usual wait. Keep it well under a
# browser's patience: a slow provider must degrade, never hang the page.
PLACES_TIMEOUT_MS=12000

# Optional. Without it OpenStreetMap is used, which publishes no star ratings,
# price levels or photos — the UI marks those as unavailable rather than
# inventing them. Set a key to get real ratings, prices and venue photos.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Dish photography
# ---------------------------------------------------------------------------
# Real CC-licensed photographs from Wikimedia Commons, resolved at seed time and
# re-checked on boot for anything still missing. Never AI-generated. Set to
# false to skip the lookup entirely and use emoji tiles.
FOOD_IMAGES_ENABLED=true
