# ---------------------------------------------------------------------------
# This project keeps its configuration next to the app that uses it:
#
#   server/.env.example  ->  copy to server/.env   (database, JWT, AI, weather, ML)
#   client/.env.example  ->  copy to client/.env   (optional; defaults work)
#
# Nothing secret belongs in client/.env — every VITE_* variable is compiled
# into the browser bundle and is publicly readable.
#
# Quick start:
#   cp server/.env.example server/.env
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   # paste that into JWT_SECRET
# ---------------------------------------------------------------------------
